{
  "name": "glowhaul-webstack",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.31.0",
  "description": "GlowHaul web platform for Out-of-the-Box Advertising.",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @glowhaul/web dev",
    "dev:web:e2e": "PLAYWRIGHT_TEST=1 pnpm --filter @glowhaul/web dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:setup-db": "playwright test --project=setup-db",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:chromium:reuse": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=chromium",
    "test:e2e:setup-db:reuse": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=setup-db",
    "test:e2e:setup-auth": "playwright test --project=setup-auth",
    "test:e2e:setup-auth:reuse": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=setup-auth",
    "test:e2e:chrome": "PLAYWRIGHT_BROWSER_CHANNEL=chrome playwright test --project=chromium",
    "test:e2e:hosted": "PLAYWRIGHT_HOSTED_SMOKE=1 PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=hosted-chromium",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}
