# App
NEXT_PUBLIC_APP_NAME=GlowHaul
# Optional canonical production URL for hosted deployments.
# Set this in Vercel production envs, not for local dev.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Supabase local-first placeholders
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
AUTH_ENFORCE_ROUTE_GUARDS=true

# Vercel system envs are injected automatically in hosted deployments.
# Do not set them for local development.
VERCEL_ENV=
VERCEL_URL=
VERCEL_BRANCH_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# Auth strategy
AUTH_PRIMARY_METHOD=magic-link
AUTH_PHONE_OTP_ENABLED=false
AUTH_PHONE_OTP_PLACEHOLDER=+15555550123
AUTH_PHONE_OTP_LENGTH=6
AUTH_PHONE_OTP_EXPIRES_IN_SECONDS=60

# Maps
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Storage
SUPABASE_STORAGE_PROOF_BUCKET=proof-uploads
